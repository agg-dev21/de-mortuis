:: StoryScript [script]
/* Title effect: letters inside .dissolve fade out one by one */
(function () {
  function dissolve(el) {
    var text = el.textContent;
    el.textContent = "";
    text.split("").forEach(function (ch) {
      var s = document.createElement("span");
      s.textContent = ch === " " ? "\u00a0" : ch;
      el.appendChild(s);
    });
    var spans = Array.prototype.slice.call(el.children);
    spans.sort(function () { return Math.random() - 0.5; });
    spans.forEach(function (s, i) {
      setTimeout(function () { s.style.opacity = "0"; s.style.filter = "blur(4px)"; }, 900 + i * 150);
    });
  }
  new MutationObserver(function () {
    document.querySelectorAll(".dissolve:not([data-done])").forEach(function (el) {
      el.setAttribute("data-done", "1");
      dissolve(el);
    });
  }).observe(document.body, { childList: true, subtree: true });
})();

:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=BIZ+UDMincho:wght@400;700&family=Reenie+Beanie&display=swap');

@font-face { font-family: 'DK Jambo'; src: url('fonts/DK Jambo.otf'); }
@font-face { font-family: 'Stay With Me'; src: url('fonts/Stay With Me.otf'); }
@font-face { font-family: 'Extra Blur'; src: url('fonts/ExtraBlur.ttf'); }

tw-story {
  background-color: #EAF2F8;
  color: #2E2433;
  font-family: 'BIZ UDMincho', Georgia, serif;
  font-size: 24px;
  line-height: 1.6;
  transition: background-color 0.8s, color 0.8s;
}
tw-passage { max-width: 820px; margin: 0 auto; }

tw-story[tags~="between"] { background-color: #16131F; color: #D9CFF2; }

tw-link, .enchantment-link {
  font-family: 'DK Jambo', 'Comic Sans MS', cursive;
  color: #C2446B;
}
tw-link:hover, .enchantment-link:hover { color: #9A2F50; }
tw-story[tags~="between"] tw-link { color: #F2C4D2; }

.act { font-family: 'DK Jambo', 'Comic Sans MS', cursive; font-size: 18px; color: #C2446B; }

.voice {
  display: inline-block;
  color: #B9A6E8; font-style: italic;
  text-shadow: -3px 0 6px rgba(194, 68, 107, 0.55), 3px 0 6px rgba(106, 85, 166, 0.55), 0 0 12px rgba(185, 166, 232, 0.6);
  animation: voice-breathe 4.5s ease-in-out infinite, voice-twitch 7s steps(1) infinite;
  transition: filter 0.4s;
}
.voice:hover { animation-play-state: paused; filter: blur(0.3px); }
@keyframes voice-breathe {
  0%, 100% { filter: blur(1.4px); }
  45%      { filter: blur(2.6px); }
  60%      { filter: blur(0.8px); }
}
@keyframes voice-twitch {
  0%, 91%, 94%, 100% { transform: translateX(0); }
  92%                { transform: translateX(-2px) skewX(-4deg); }
  93%                { transform: translateX(2px); }
}
@media (prefers-reduced-motion: reduce) {
  .voice { animation: none; filter: blur(1.4px); }
}
.voice-clear { color: #B9A6E8; font-style: italic; }

.echo1 { font-family: 'Stay With Me', cursive; color: #6A55A6; }
.echo2 { font-family: 'Reenie Beanie', cursive; font-size: 1.4em; color: #7A2E4A; }
.echo3 { font-family: 'Extra Blur', sans-serif; letter-spacing: 2px; }

.title { text-align: center; font-size: 2.4em; margin-top: 100px; }
.dissolve { display: block; text-align: center; font-style: italic; letter-spacing: 0.3em; }
.dissolve span { display: inline-block; transition: opacity 0.6s, filter 0.6s; }
.phone { font-family: 'BIZ UDMincho', serif; background: #FFFFFF; color: #2E2433; border-radius: 14px; padding: 6px 14px; display: inline-block; }